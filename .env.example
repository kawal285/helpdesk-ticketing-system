NODE_ENV=development
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# The tests use a second database named DB_NAME + "_test" (here
# helpdesk_dev_test). Create both. The tests wipe the _test one.
DB_NAME=helpdesk_dev

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Admin bootstrap seeder (npm run seed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
GEMINI_MODEL=gemini-3.6S-flash
GEMINI_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="OP IT Helpdesk <helpdesk@example.com>"
FRONTEND_URL=http://localhost:5173

# Swappable backends -- see docs/PROVIDERS.md. Leave unset to use the
# defaults below (this app's own local JSON file / MySQL tables). Set
# to the name of a registered provider to point the platform at a
# different CRM or hosted knowledge base instead.
KNOWLEDGE_BASE_PROVIDER=local-json
TICKET_PROVIDER=local-sequelize

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

RAG_SIMILARITY_THRESHOLD=0.59
RAG_TOP_K=4
RAG_MAX_PER_ARTICLE=2
RAG_RELATIVE_CUTOFF=0.06
GENERATION_PROVIDER=ollama
GENERATION_MODEL=llama3.2

# Web search, consulted alongside the knowledge base on every assistant
# question. "duckduckgo" needs no API key. Set to "none" to answer from the
# knowledge base only.
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_MAX_RESULTS=3

# ---- Optional: everything below has a sensible default --------------------

# Ollama address and timeouts. A local model on a laptop CPU can take
# 20-30s for its first answer while it loads.
# OLLAMA_HOST=http://127.0.0.1:11434
# AI_TIMEOUT_MS=60000
# GENERATION_TIMEOUT_MS=60000

# Groq (cloud) for the assistant's agents instead of local Ollama.
# GROQ_API_KEY=
# AGENT_THINK_PROVIDER=groq
# AGENT_THINK_MODEL=

# Cut-offs chosen from the evaluations in docs/ (see each doc for why).
# SIMILAR_TICKET_THRESHOLD=0.73     # similar/duplicate tickets
# AI_PRIORITY_CONFIDENCE_MIN=0.5    # "Needs human check" handoff
# AI_CATEGORY_CONFIDENCE_MIN=0.5
# RAG_LOW_CONFIDENCE_MARGIN=0.05    # weak assistant answers
# KB_GAP_GROUP_THRESHOLD=0.68       # knowledge-gap topics